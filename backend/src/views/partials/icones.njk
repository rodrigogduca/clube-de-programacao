    <svg width="{{ tamanho }}" height="{{ tamanho }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7.5 2.5 10 9M16.5 2.5 14 9"></path><path d="M9 2.5h6"></path><circle cx="12" cy="15" r="6.5"></circle><path d="m12 11.8 1 2 2.2.3-1.6 1.5.4 2.2-2-1-2 1 .4-2.2-1.6-1.5 2.2-.3z" fill="currentColor" stroke-width="1"></path></svg>
  {%- elif nome == 'presente' -%}
