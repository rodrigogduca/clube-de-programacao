  {%- elif nome == 'certo' -%}
    <svg width="{{ tamanho }}" height="{{ tamanho }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="m8 12.3 2.7 2.7L16 9.7"></path></svg>
  {#- PRÊMIOS DAS COMPETIÇÕES — traço de 2px, o mesmo peso de `certo` e
      `proibido`, para a coluna de prêmios ler como uma família só. -#}
  {%- elif nome == 'ssd' -%}
    <svg width="{{ tamanho }}" height="{{ tamanho }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="7" width="20" height="10" rx="1.5"></rect><path d="M5 17v2M8 17v2M11 17v2M14 17v2"></path><rect x="5" y="10" width="7" height="4" rx=".5"></rect><circle cx="17.5" cy="12" r="1.2"></circle></svg>
  {%- elif nome == 'kit-gamer' -%}
    <svg width="{{ tamanho }}" height="{{ tamanho }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="1.5" y="9" width="14" height="9" rx="1.5"></rect><path d="M4.5 12h.01M7.5 12h.01M10.5 12h.01M12.5 12h.01M5.5 15h6"></path><rect x="17.5" y="9" width="5" height="9" rx="2.5"></rect><path d="M20 9v3"></path><path d="M20 9c0-2 1-3 2.5-3.5"></path></svg>
